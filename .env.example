# ══════════════════════════════════════════════════════════════
# Central TI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env NUNCA deve ser commitado no Git.
# ══════════════════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────────────────
# Acesse: supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# ─── API (Frontend → Backend) ──────────────────────────────────
# Em desenvolvimento local: deixe em branco ou apague (usa http://localhost:3001)
# Em produção na Vercel: defina como /api
VITE_API_URL=/api

# ─── Banco de Dados (desenvolvimento local) ────────────────────
# Não necessário se DATABASE_URL estiver preenchida
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chamados_ti
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ─── Banco de Dados (produção — Supabase connection pooler) ────
# Acesse: supabase.com → seu projeto → Settings → Database → Connection string → Transaction
# Use a string com ?pgbouncer=true
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-xx.pooler.supabase.com:6543/postgres

# ─── CORS (produção) ───────────────────────────────────────────
# URL do seu deploy na Vercel (pode ser mais de uma, separada por vírgula)
CORS_ORIGIN=https://seu-projeto.vercel.app

# ─── Impressora Zebra (apenas ambiente Windows local) ──────────
# Nome exato conforme aparece no Gerenciador de Dispositivos
PRINTER_NAME=Nome da sua impressora aqui

# ─── Porta local do servidor ───────────────────────────────────
API_PORT=3001
