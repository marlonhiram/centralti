# ─── Banco de Dados PostgreSQL ──────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com suas credenciais locais
# O arquivo .env NUNCA deve ser commitado no Git

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chamados_ti
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ─── Impressora Zebra ───────────────────────────────────────────────────────────
# Nome exato da impressora conforme aparece no Gerenciador de Dispositivos do Windows
PRINTER_NAME=Nome da sua impressora aqui

# ─── Portas da aplicação ────────────────────────────────────────────────────────
API_PORT=3001
FRONT_PORT=5173

# ─── Supabase (opcional — não utilizado na versão local) ────────────────────────
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua_chave_aqui
